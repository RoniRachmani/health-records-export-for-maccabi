node_modules/
dist/
dist-dev/
dist-store/
release/
coverage/
*.zip
*.log
.DS_Store
.env*

# The extension manifest is generated from manifest.config.ts into the build
# folders; one at the root is a stray.
/manifest.json

# Chrome's "Pack extension" writes the package and its private signing key
# next to the folder it packs, which is this repo for dist/.
*.crx
*.pem

# The promo video is rendered on demand (npm run store-video) and uploaded to YouTube, which is
# what the store's video field takes; the repo keeps the source that draws it, not the megabytes.
# Its soundtrack preview likewise, and the narration clips ElevenLabs returns, kept so a re-render
# doesn't pay for them again.
store/assets/*.mp4
store/assets/*.wav
/.cache/

# Never commit real exports or anything taken from a real account.
maccabi-export-*/
*.token
*.pdf
*.raw.json
