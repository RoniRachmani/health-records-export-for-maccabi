{
  "name": "health-records-export-for-maccabi",
  "version": "0.8.12",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Chrome extension that exports your Maccabi online medical records (raw JSON + PDFs) as one ZIP. Unofficial.",
  "license": "MIT",
  "author": "Roni Rachmani",
  "homepage": "https://github.com/RoniRachmani/health-records-export-for-maccabi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoniRachmani/health-records-export-for-maccabi.git"
  },
  "bugs": "https://github.com/RoniRachmani/health-records-export-for-maccabi/issues",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "live": "vite build --mode development && node scripts/live-run.mjs",
    "export": "node scripts/headless-export.mjs",
    "env": "op inject -i .env.tpl -o .env",
    "endpoints": "node tools/endpoint-scan/endpoint-scan.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "store-video": "node scripts/store-video.mjs",
    "film:before-thursday": "node scripts/store-video.mjs --before-thursday",
    "film:before-thursday:all": "npm run film:before-thursday && npm run film:before-thursday -- --captions",
    "site-check": "node scripts/site-check.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "clean": "node -e \"for (const d of ['dist', 'dist-dev', 'dist-store', 'dist-cli', 'release']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "release:zip": "npm run clean && npm test && npm run build:dev && npm run package",
    "release": "npm run release:zip && npm run store-assets && npm run store-video"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@fontsource-variable/heebo": "5.3.0",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
